# Copy to .env and fill in your key:  https://smith.langchain.com
# Tracing turns on automatically when LANGSMITH_API_KEY is set.

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-ai

# Guardrails AI screens prompts before the LLM runs.
# Regex validators always run when true; LLM second-pass uses the same chat model.
AGENTIC_AI_GUARDRAILS=true
AGENTIC_AI_GUARDRAILS_LLM=true
